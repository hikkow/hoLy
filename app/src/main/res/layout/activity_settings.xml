<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/rootSettingsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings Настройки"
            android:textColor="@color/accent"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Скорость скрипта"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:layout_marginTop="24dp"/>

        <Spinner
            android:id="@+id/spSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_blue"
            android:padding="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Прозрачность водного знака"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:layout_marginTop="24dp"/>

        <TextView
            android:id="@+id/tvAlpha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dim"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>

        <SeekBar
            android:id="@+id/sbAlpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:progressTint="@color/accent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ловить наклейки (HoLy | Nakl)"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:layout_marginTop="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 наклейка игнорируется автоматически"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:layout_marginTop="4dp"/>

        <CheckBox
            android:id="@+id/cb2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="С 2 наклейками"
            android:textColor="@color/text"
            android:buttonTint="@color/accent"/>

        <CheckBox
            android:id="@+id/cb3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="С 3 наклейками"
            android:textColor="@color/text"
            android:buttonTint="@color/accent"/>

        <CheckBox
            android:id="@+id/cb4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="С 4 наклейками"
            android:textColor="@color/text"
            android:buttonTint="@color/accent"/>
    </LinearLayout>
</ScrollView>
